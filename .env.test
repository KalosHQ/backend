NODE_ENV=test
PORT=0
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kalos_test?schema=public
JWT_ACCESS_SECRET=test-access-secret
JWT_REFRESH_SECRET=test-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
COOKIE_SECRET=test-cookie-secret
REDIS_URL=redis://localhost:6379
OTP_TTL_SECONDS=600
OTP_LENGTH=6
OTP_RESEND_COOLDOWN_SECONDS=1
OTP_MAX_VERIFY_ATTEMPTS=3
OTP_MAX_REQUESTS_PER_WINDOW=10
OTP_REQUEST_WINDOW_SECONDS=3600
RESEND_API_KEY=re_test_key
EMAIL_FROM=Kalos <no-reply@test.kalos.local>
MAIL_MAX_RETRIES=1
MAIL_RETRY_DELAY_MS=10
