# ====================================
# KALOS BACKEND - ENVIRONMENT VARIABLES
# ====================================
# Copy this file to `.env` and fill in your values
# Never commit the actual `.env` file to version control!

# ====================================
# APPLICATION
# ====================================
NODE_ENV="development"                    # Options: development, production, test
PORT=4000                                 # Port the server will listen on
APP_URL=http://localhost:4000

# ====================================
# DATABASE
# ====================================
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://postgres:password@localhost:5432/kalos?schema=public"

# For development with Docker:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kalos?schema=public"

# ====================================
# JWT AUTHENTICATION
# ====================================
# Access Token (short-lived for API requests)
JWT_SECRET="your-secret-access-token-key-change-this-in-production"
JWT_EXPIRES_IN="15m"

# Alternative names (supported for backward compatibility):
# JWT_ACCESS_TOKEN_SECRET
# JWT_ACCESS_SECRET
# JWT_ACCESS_EXPIRES_IN

# Refresh Token (long-lived for token renewal)
JWT_REFRESH_SECRET="your-secret-refresh-token-key-change-this-in-production"
REFRESH_TOKEN_EXPIRES_IN="30d"

# Alternative names (supported for backward compatibility):
# JWT_REFRESH_TOKEN_SECRET

# ====================================
# SECURITY
# ====================================
# Bcrypt salt rounds (higher = more secure but slower)
BCRYPT_SALT_ROUNDS=10

# Cookie secret for session management
COOKIE_SECRET="your-cookie-secret-key-change-this-in-production"

# Optional cookie seed for additional entropy
COOKIE_SEED="optional-cookie-seed-value"

# ====================================
# EMAIL (Optional)
# ====================================
# Resend configuration for sending emails
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxx"
EMAIL_FROM="Kalos <no-reply@yourdomain.com>" # Must be a verified sender/domain in Resend

# ====================================
# FILE STORAGE
# ====================================
# Storage provider: 'local' or 's3'
STORAGE_PROVIDER="s3"

# AWS S3 Configuration (if using S3)
S3_PRIVATE_BUCKET="kalos-private-storage"
S3_PUBLIC_BUCKET="kalos-public-storage"
S3_BUCKET="kalos-private-storage" # Backward-compatible fallback for private bucket
# AWS credentials should be configured via AWS CLI or IAM roles
# For local development, you can use:
# AWS_ACCESS_KEY_ID="your-aws-access-key"
# AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
# AWS_REGION="us-east-1"

# Queue + Cache (Redis)
REDIS_URL="redis://localhost:6379"
OTP_TTL_SECONDS=600
OTP_LENGTH=6
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_MAX_REQUESTS_PER_WINDOW=5
OTP_REQUEST_WINDOW_SECONDS=3600
MAIL_MAX_RETRIES=3
MAIL_RETRY_DELAY_MS=300

# AI callback authentication (optional but recommended)
AI_WEBHOOK_TOKEN="set-a-shared-secret-token"

# ====================================
# OAUTH PROVIDERS (Optional)
# ====================================
# Facebook OAuth
FACEBOOK_CLIENT_ID="your-facebook-app-id"
FACEBOOK_CLIENT_SECRET="your-facebook-app-secret"
# Get credentials from: https://developers.facebook.com/apps/

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
# Get credentials from: https://console.cloud.google.com/apis/credentials

# ====================================
# NOTES FOR PRODUCTION
# ====================================
# 1. Generate strong, random secrets for JWT and COOKIE_SECRET
#    Example: openssl rand -base64 32
#
# 2. Use environment-specific secrets (don't reuse dev secrets in prod)
#
# 3. Consider using a secrets manager:
#    - AWS Secrets Manager
#    - HashiCorp Vault
#    - Azure Key Vault
#
# 4. Set NODE_ENV=production in production
#
# 5. Use SSL/TLS for DATABASE_URL in production
#
# 6. Rotate secrets regularly
#
# 7. Use IAM roles instead of hardcoded AWS credentials when possible
